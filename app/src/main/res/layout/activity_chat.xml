<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- MAIN CONTENT -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#F6F6F6">

        <!-- HEADER -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="90dp"
            android:background="#810000"
            android:padding="16dp"
            android:elevation="4dp">

            <ImageView
                android:id="@+id/menuBtn"
                android:layout_width="45dp"
                android:layout_height="45dp"
                android:src="@android:drawable/ic_menu_sort_by_size"
                android:tint="#FFFFFF"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:contentDescription="Menu" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CITU-CARE"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="20sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Chat Assistant"
                    android:textColor="#E0E0E0"
                    android:textSize="15sp" />
            </LinearLayout>

            <ImageView
                android:id="@+id/profileBtn"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="@drawable/bg_profile_circle"
                android:contentDescription="Profile"
                android:padding="2dp"
                android:scaleType="centerCrop"
                android:src="@drawable/citu_logo" />

        </RelativeLayout>

        <!-- CHAT AREA -->
        <ScrollView
            android:id="@+id/chatScroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:padding="12dp">

            <LinearLayout
                android:id="@+id/chatContainer"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </ScrollView>

        <!-- INPUT BAR -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FFFFFF"
            android:elevation="6dp"
            android:padding="10dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <EditText
                android:id="@+id/messageInput"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="55dp"
                android:hint="Type your message..."
                android:textSize="20sp"
                android:textColor="#111111"
                android:textColorHint="#777777"
                android:background="@drawable/bg_input"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:singleLine="true"
                android:layout_marginEnd="10dp" />

            <ImageButton
                android:id="@+id/sendBtn"
                android:layout_width="55dp"
                android:layout_height="55dp"
                android:background="@drawable/bg_send_btn"
                android:src="@android:drawable/ic_menu_send"
                android:tint="#000000"
                android:contentDescription="Send" />
        </LinearLayout>

    </LinearLayout>

    <!-- SIDEBAR -->
    <LinearLayout
        android:id="@+id/sidebarMenu"
        android:layout_width="250dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:orientation="vertical"
        android:background="#8B0000"
        android:padding="16dp">

        <!-- Sidebar Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="18dp">

            <TextView
                android:id="@+id/backBtn"
                android:layout_width="45dp"
                android:layout_height="45dp"
                android:text="←"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                android:gravity="center" />

            <TextView
                android:id="@+id/sidebarTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CITU-CARE"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="20sp"
                android:layout_marginStart="8dp" />
        </LinearLayout>

        <!-- New Chat -->
        <Button
            android:id="@+id/newChatBtn"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="+  New Chat"
            android:textColor="#000000"
            android:textStyle="bold"
            android:backgroundTint="#FFD700"
            android:layout_marginBottom="18dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="RECENT CHATS"
            android:textColor="#DDDDDD"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <!-- Recent Sessions Scroll Area -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="false">

            <LinearLayout
                android:id="@+id/sessionListContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>

        <!-- Bottom Buttons -->
        <Button
            android:id="@+id/settingsBtn"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="Settings"
            android:textColor="#000000"
            android:textStyle="bold"
            android:backgroundTint="#FFD700"
            android:layout_marginTop="12dp" />
    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>